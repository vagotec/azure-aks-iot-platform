apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${ROS2_SIMULATOR_NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: ros2-simulator
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: ros2-simulator
      app.kubernetes.io/part-of: ${PROJECT_NAME}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ros2-simulator
        app.kubernetes.io/part-of: ${PROJECT_NAME}
    spec:
      containers:
        - name: ros2-simulator
          image: ${ROS2_SIMULATOR_IMAGE}
          imagePullPolicy: Never
          env:
            - name: ROS2_TOPIC
              value: "${ROS2_TOPIC}"

            - name: ROS2_COMMAND_TOPIC
              value: "${ROS2_COMMAND_TOPIC}"
            - name: ROS_DOMAIN_ID
              value: "${ROS_DOMAIN_ID}"
            - name: DEVICE_ID
              value: "${DEVICE_ID}"
            - name: PUBLISH_INTERVAL_SECONDS
              value: "${PUBLISH_INTERVAL_SECONDS}"
