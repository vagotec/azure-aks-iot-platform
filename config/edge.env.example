# ============================================================
# Azure AKS IoT Platform - Edge Configuration Example
# Copy this file to edge.env and adjust values as required.
# ============================================================

PROJECT_NAME=azure-aks-iot-platform

# Kubernetes
K8S_NAMESPACE=azure-aks-iot

# Eclipse Mosquitto
MOSQUITTO_IMAGE=eclipse-mosquitto:2.1.2-alpine
MOSQUITTO_NAME=azure-aks-iot-platform-mosquitto
MOSQUITTO_CONFIGMAP=azure-aks-iot-platform-mosquitto-config
MOSQUITTO_PVC=azure-aks-iot-platform-mosquitto-data
MOSQUITTO_PORT=1883
MOSQUITTO_STORAGE_SIZE=1Gi

# MQTT test configuration
MQTT_TEST_TOPIC=azure-aks-iot-platform/test/mqtt5
MQTT_TEST_MESSAGE=hello-from-azure-aks-iot-platform
MQTT_QOS=1

# ============================================================
# ROS 2 Simulator
# ============================================================

ROS2_SIMULATOR_IMAGE=azure-aks-iot-platform-ros2-simulator:local
ROS2_SIMULATOR_NAME=azure-aks-iot-platform-ros2-simulator

ROS2_TOPIC=/iot/telemetry
ROS_DOMAIN_ID=42
DEVICE_ID=edge-device-001
PUBLISH_INTERVAL_SECONDS=2.0

# ============================================================
# C++ Backend Service
# ============================================================

BACKEND_IMAGE=azure-aks-iot-platform-backend:local
BACKEND_NAME=azure-aks-iot-platform-backend

ROS2_COMMAND_TOPIC=/iot/command

MQTT_HOST=azure-aks-iot-platform-mosquitto
MQTT_PORT=1883
MQTT_TOPIC=azure-aks-iot-platform/telemetry
MQTT_COMMAND_TOPIC=azure-aks-iot-platform/command
MQTT_CLIENT_ID=azure-aks-iot-platform-backend

# ============================================================
# Mosquitto Prometheus Exporter
# ============================================================


# Mosquitto Prometheus Exporter
MOSQUITTO_EXPORTER_IMAGE=ghcr.io/d0ugal/mosquitto-exporter:v0.2.51
MOSQUITTO_EXPORTER_NAME=azure-aks-iot-platform-mosquitto-exporter
MOSQUITTO_EXPORTER_PORT=9234

# Prometheus
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
PROMETHEUS_NAME=azure-aks-iot-platform-prometheus
PROMETHEUS_CONFIGMAP=azure-aks-iot-platform-prometheus-config
PROMETHEUS_PVC=azure-aks-iot-platform-prometheus-data
PROMETHEUS_PORT=9090
PROMETHEUS_STORAGE_SIZE=1Gi
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana
GRAFANA_IMAGE=grafana/grafana-oss:13.0.2
GRAFANA_NAME=azure-aks-iot-platform-grafana
GRAFANA_PROVISIONING_CONFIGMAP=azure-aks-iot-platform-grafana-provisioning
GRAFANA_PVC=azure-aks-iot-platform-grafana-data
GRAFANA_PORT=3000
GRAFANA_STORAGE_SIZE=1Gi
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# C++ Backend REST API
REST_HOST=0.0.0.0
REST_PORT=8080
