# ============================================================
# Azure AKS IoT Platform - Local K3s Configuration Example
# ============================================================
#
# Copy to:
#   config/k3s.env
#
# config/k3s.env is machine-specific and MUST NOT be committed.
# ============================================================

K3S_VERSION=v1.36.4+k3s1

# Kubernetes node identity.
# Must be unique when additional nodes are added later.
K3S_NODE_NAME=development-pc

# Host interface used by K3s/Flannel.
K3S_NETWORK_INTERFACE=wlp129s0f0

# "auto" resolves the current IPv4 address from
# K3S_NETWORK_INTERFACE during deployment.
#
# A fixed address may also be configured, for example:
# K3S_NODE_IP=192.168.2.50
K3S_NODE_IP=auto

# Kubernetes networking.
K3S_CLUSTER_CIDR=10.42.0.0/16
K3S_SERVICE_CIDR=10.43.0.0/16

# K3s packaged Traefik is disabled because this project
# uses Gateway API + Envoy Gateway.
K3S_DISABLE_TRAEFIK=true
