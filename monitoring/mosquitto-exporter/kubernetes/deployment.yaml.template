apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${MOSQUITTO_EXPORTER_NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: mosquitto-exporter
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: mosquitto-exporter
      app.kubernetes.io/part-of: ${PROJECT_NAME}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: mosquitto-exporter
        app.kubernetes.io/part-of: ${PROJECT_NAME}
    spec:
      containers:
        - name: mosquitto-exporter
          image: ${MOSQUITTO_EXPORTER_IMAGE}
          imagePullPolicy: IfNotPresent

          env:
            - name: MOSQUITTO_BROKER_ENDPOINT
              value: "tcp://${MOSQUITTO_NAME}.${K8S_NAMESPACE}.svc.cluster.local:${MQTT_PORT}"

            - name: LOG_LEVEL
              value: "info"

            - name: LOG_FORMAT
              value: "json"

          ports:
            - name: metrics
              containerPort: ${MOSQUITTO_EXPORTER_PORT}
              protocol: TCP

          readinessProbe:
            httpGet:
              path: /health
              port: metrics
            initialDelaySeconds: 3
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3

          livenessProbe:
            httpGet:
              path: /health
              port: metrics
            initialDelaySeconds: 10
            periodSeconds: 30
            timeoutSeconds: 3
            failureThreshold: 3

---
apiVersion: v1
kind: Service
metadata:
  name: ${MOSQUITTO_EXPORTER_NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: mosquitto-exporter
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: mosquitto-exporter
    app.kubernetes.io/part-of: ${PROJECT_NAME}
  ports:
    - name: metrics
      port: ${MOSQUITTO_EXPORTER_PORT}
      targetPort: metrics
      protocol: TCP
