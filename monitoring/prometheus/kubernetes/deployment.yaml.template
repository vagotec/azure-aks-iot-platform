apiVersion: v1
kind: ConfigMap
metadata:
  name: ${PROMETHEUS_CONFIGMAP}
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/part-of: ${PROJECT_NAME}
data:
  prometheus.yml: |
${PROMETHEUS_CONFIG_INDENTED}

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${PROMETHEUS_PVC}
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: ${PROMETHEUS_STORAGE_SIZE}

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${PROMETHEUS_NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  replicas: 1

  selector:
    matchLabels:
      app.kubernetes.io/name: prometheus
      app.kubernetes.io/part-of: ${PROJECT_NAME}

  template:
    metadata:
      labels:
        app.kubernetes.io/name: prometheus
        app.kubernetes.io/part-of: ${PROJECT_NAME}

    spec:
      containers:
        - name: prometheus
          image: ${PROMETHEUS_IMAGE}
          imagePullPolicy: IfNotPresent

          args:
            - --config.file=/etc/prometheus/prometheus.yml
            - --storage.tsdb.path=/prometheus

          ports:
            - name: http
              containerPort: ${PROMETHEUS_PORT}
              protocol: TCP

          readinessProbe:
            httpGet:
              path: /-/ready
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 6

          livenessProbe:
            httpGet:
              path: /-/healthy
              port: http
            initialDelaySeconds: 10
            periodSeconds: 30
            timeoutSeconds: 3
            failureThreshold: 3

          volumeMounts:
            - name: config
              mountPath: /etc/prometheus
              readOnly: true

            - name: data
              mountPath: /prometheus

      volumes:
        - name: config
          configMap:
            name: ${PROMETHEUS_CONFIGMAP}

        - name: data
          persistentVolumeClaim:
            claimName: ${PROMETHEUS_PVC}

---
apiVersion: v1
kind: Service
metadata:
  name: ${PROMETHEUS_NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  type: ClusterIP

  selector:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/part-of: ${PROJECT_NAME}

  ports:
    - name: http
      port: ${PROMETHEUS_PORT}
      targetPort: http
      protocol: TCP
